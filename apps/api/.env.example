NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nido:nido@localhost:5432/nido
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
# Keep this service-account file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Reverse proxies in front of the API, counted from the app outwards. 0 (the default) trusts
# nothing and reads the client address from the socket, which is correct when running locally.
# Set it to 1 on Render, and never higher than the real hop count: an over-trusted chain lets a
# caller forge X-Forwarded-For and pick their own rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# --- Notifications (ADR 0012). Private to the API: none of these may ever carry an EXPO_PUBLIC_
# --- prefix, which would publish the value in the client bundle.
# They are left commented out rather than assigned an empty value: the schema treats these as
# optional, and `undefined` is what disables the feature. An empty string is a value, and a
# blank one fails validation and stops the API from booting.
# Optional as a group. All three unset disables device registration and leaves the app booting
# normally; some set and others unset is a deployment mistake and fails at startup.
# Keys are `keyId:base64key` pairs, comma-separated. Generate one with:
#   node -e "console.log('k1:' + require('node:crypto').randomBytes(32).toString('base64'))"
#NOTIFICATION_CREDENTIAL_KEYS=
#NOTIFICATION_CREDENTIAL_ACTIVE_KEY_ID=
# Separate secret for the credential fingerprint HMAC, so the index cannot reconstruct a token.
#NOTIFICATION_CREDENTIAL_PEPPER=

# Web Push VAPID pair, also optional as a group. Generate with:
#   pnpm --filter @nido/api exec web-push generate-vapid-keys
# The private half must never leave the API; the client reads the public half from
# GET /v1/notifications/vapid-public-key.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# A mailto: or https: URL the push service can use to contact the sender.
#VAPID_SUBJECT=

# Shared with the GitHub Actions scheduler that calls POST /v1/internal/jobs/due-notifications.
# Minimum 32 characters. Unset keeps that endpoint closed, which is the safe direction for a route
# with no user authentication. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#NOTIFICATIONS_JOB_HMAC_SECRET=
